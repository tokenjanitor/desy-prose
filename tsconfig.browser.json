{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false,
    "rootDir": "examples/src",
    "outDir": "examples"
  },
  "include": ["examples/src/**/*.ts"],
  "exclude": []
}
